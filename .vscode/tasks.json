      "command": "docker compose -f docker/compose.yml up -d keycloak; powershell -NoProfile -Command 'foreach($i in 1..60){ try { $r = Invoke-WebRequest -Uri \"http://localhost:8090/realms/paideia/.well-known/openid-configuration\" -UseBasicParsing -TimeoutSec 2; if ($r.StatusCode -eq 200) { Write-Host \"KEYCLOAK READY\"; exit 0 } } catch {}; Start-Sleep -Seconds 2 }; Write-Host \"ERROR: Keycloak no respondio en 120s\"; exit 1'",
      "problemMatcher": []
    },

