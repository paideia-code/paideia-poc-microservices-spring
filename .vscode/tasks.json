      "problemMatcher": {
        "owner": "spring-boot-config",
        "pattern": { "regexp": "." },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^.*Starting \\S*Application.*$",
          "endsPattern": "^.*(Started \\S+Application|Tomcat started on port).*$"
